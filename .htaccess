<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internally forward all requests into the public/ folder, which holds
    # Laravel's front controller. Azure App Service's PHP (Code deployment)
    # serves from the repo root, not public/, so without this the site has
    # no index.php to find.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
